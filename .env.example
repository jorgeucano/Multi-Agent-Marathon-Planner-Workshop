# --- Required ---------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=<YOUR_PROJECT_ID>
# Gemini 3.x models are served from the `global` location. With us-central1
# (the codelab default) every 3.x model returns 404. Verified 2026-09-21.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Full Team mode (Planner -> Simulator over A2A) -------------------------
# Local simulator server:   local:8089
# Deployed to Agent Engine: projects/<p>/locations/<l>/reasoningEngines/<id>
# SIMULATOR_AGENT_RESOURCE_NAME=local:8089

# --- Models -----------------------------------------------------------------
# The codelab's gemini-3-flash-preview / gemini-3.1-pro-preview exist only in
# location=global. This is the config the workshop was rehearsed with: one
# cheap, fast, GA flash model for all four agents.
PLANNER_MODEL=gemini-3.1-flash-lite
EVALUATOR_MODEL=gemini-3.1-flash-lite
SIMULATOR_MODEL=gemini-3.1-flash-lite
RUNNER_MODEL=gemini-3.1-flash-lite
# Codelab-faithful alternative (also needs location=global):
# PLANNER_MODEL=gemini-3-flash-preview
# EVALUATOR_MODEL=gemini-3.1-pro-preview
# SIMULATOR_MODEL=gemini-3-flash-preview
# RUNNER_MODEL=gemini-3-flash-preview

# --- Optional: Memory Bank + persistent sessions (needs an Agent Engine) -----
# Without AGENT_ENGINE_ID the agents fall back to in-memory sessions and
# Memory Bank writes are silently skipped. See docs/GOTCHAS.md #7.
# AGENT_ENGINE_ID=
# AGENT_ENGINE_LOCATION=us-central1

# --- Optional --------------------------------------------------------------
# BUCKET_URI=
