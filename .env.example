# --- Required ---------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=<YOUR_PROJECT_ID>
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Full Team mode (Planner -> Simulator over A2A) -------------------------
# Local simulator server:   local:8089
# Deployed to Agent Engine: projects/<p>/locations/<l>/reasoningEngines/<id>
# SIMULATOR_AGENT_RESOURCE_NAME=local:8089

# --- Optional: model overrides (swap here if a preview model is unavailable) -
# PLANNER_MODEL=gemini-3-flash-preview
# EVALUATOR_MODEL=gemini-3.1-pro-preview
# SIMULATOR_MODEL=gemini-3-flash-preview

# --- Optional: Memory Bank + persistent sessions (needs an Agent Engine) -----
# Without AGENT_ENGINE_ID the agents fall back to in-memory sessions and
# Memory Bank writes are silently skipped. See docs/GOTCHAS.md #7.
# AGENT_ENGINE_ID=
# AGENT_ENGINE_LOCATION=us-central1

# --- Optional --------------------------------------------------------------
# BUCKET_URI=
